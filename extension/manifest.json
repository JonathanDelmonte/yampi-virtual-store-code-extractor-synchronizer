{
  "manifest_version": 3,
  "name": "Zirtuno Sync Yampi",
  "version": "0.4.0",
  "author": "Zirtuno",
  "minimum_chrome_version": "120",
  "description": "Edite localmente e sincronize o código da sua loja Yampi.",
  "homepage_url": "https://github.com/JonathanDelmonte/yampi-virtual-store-code-extractor-synchronizer",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads",
    "sidePanel"
  ],
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "Abra o Editor de código da Yampi. Clique para ver como baixar ou enviar arquivos.",
    "default_icon": {
      "16": "icons/icon16.png",
      "24": "icons/icon24.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src https:"
  },
  "optional_host_permissions": [
    "https://*/*"
  ]
}
