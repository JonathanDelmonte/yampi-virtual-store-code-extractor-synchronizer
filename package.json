{
  "name": "zirtuno-sync-yampi",
  "version": "0.7.0",
  "author": {"name": "Zirtuno", "url": "https://www.instagram.com/zirtuno/"},
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "description": "Zirtuno Sync Yampi: edição local e sincronização do código da loja",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build && node scripts/e2e.mjs",
    "test:preview": "node scripts/preview-e2e.mjs",
    "test:compression": "npm run build && node scripts/compression-e2e.mjs",
    "audit:performance": "npm run build && node scripts/performance-audit.mjs current",
    "check": "npm run typecheck && npm test && npm run build",
    "package": "npm run check && node scripts/package.mjs",
    "test:panel": "npm run build && node scripts/panel-e2e.mjs",
    "test:direct": "npm run build && node scripts/direct-e2e.mjs"
  },
  "devDependencies": {
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.0",
    "@codemirror/view-legacy": "npm:@codemirror/view@6.36.2",
    "@fontsource-variable/atkinson-hyperlegible-mono": "5.3.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@splidejs/splide": "4.1.4",
    "@types/chrome": "^0.1.0",
    "@types/node": "^24.0.0",
    "acorn": "8.15.0",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "6.2.5",
    "fflate": "^0.8.3",
    "js-cookie": "3.0.8",
    "lodash": "4.18.1",
    "parse5": "8.0.1",
    "playwright": "1.64.0",
    "sass": "1.105.1",
    "sharp": "0.35.5",
    "twing": "7.3.1",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3",
    "vue": "2.7.16",
    "vue-template-compiler": "2.7.16",
    "vuex": "3.6.2"
  },
  "overrides": {
    "locutus": "3.0.36"
  }
}
